rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function validState() {
   let d = request.resource.data;
   return d.keys().hasAll(['payload','revision','updatedAt','device'])
    && d.keys().hasOnly(['payload','revision','updatedAt','device'])
    && d.payload is string && d.payload.size() <= 750000
    && d.revision is int && d.revision >= 1
    && d.device is string && d.device.size() <= 80
    && d.updatedAt == request.time;
  }
  match /users/{uid}/mushafi/state {
   allow read: if owner(uid);
   allow create: if owner(uid) && validState() && request.resource.data.revision == 1;
   allow update: if owner(uid) && validState() && request.resource.data.revision == resource.data.revision + 1;
   allow delete: if owner(uid);
  }
  match /{document=**} { allow read, write: if false; }
 }
}
