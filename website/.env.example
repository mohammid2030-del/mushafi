# Optional, temporary upload authorization. Configure in Sites; never in the browser.
RELEASE_UPLOAD_KEY=

# Server-only FCM service account JSON; Firebase project mushafiapp-1b3d7.
FCM_SERVICE_ACCOUNT_JSON=
# Temporary authorization for the publisher; remove after announcing a release.
RELEASE_PUSH_KEY=

# Enable automatic FCM announcement after a ready published release feed is read.
FCM_RELEASE_PUSH_ENABLED=
